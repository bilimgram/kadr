{
  "name": "kadr",
  "private": true,
  "description": "Open-source, local-first screen recorder with a live webcam bubble and AI editing.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:desktop": "pnpm --filter @kadr/desktop dev",
    "dev:web": "pnpm --filter @kadr/web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "changeset": "changeset",
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all",
    "prepare": "node scripts/install-git-hooks.mjs",
    "release:desktop": "pnpm --filter @kadr/desktop release"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@changesets/cli": "^3.0.3",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
