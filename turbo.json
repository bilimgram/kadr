{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json", "pnpm-workspace.yaml"],
  "globalPassThroughEnv": ["CI", "KADR_SKIP_GIT_HOOKS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["KADR_WEB_BASE"],
      "outputs": ["dist/**", "out/**"]
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
