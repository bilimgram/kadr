# Copy to .env (gitignored) for local desktop releases. CI uses repository secrets/variables
# with the same names. See docs/RELEASING.md.

# Public update feed baked into installers (electron-updater "generic" provider).
# Must be a path under R2_PUBLIC_URL. Choose it carefully: installed apps keep polling it.
KADR_UPDATE_URL=

# Cloudflare R2 (S3 API) — used only by scripts/publish-update.mjs to upload releases.
R2_ENDPOINT=
R2_BUCKET=
R2_REGION=auto
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PUBLIC_URL=
